wcnt-1.32/jwmsynth

samplerate 44100


timer
t
    timings
        time seconds 0
        time seconds 1
    timings
    time_is_relative off
t

autogroup_create
group1
    clock
    clock1
        freq 5
    clock1

    wave
    wave1
        type sine
        in_phase_step clock1 out_phase_step
    wave1

    clock
    clock2
        freq 0.5
    clock2

    lfo_controller
    ctrl1
        in_trig clock2 out_phase_trig
        start_level 0.0
        end_level 1.0
        delay_time 0.5
        ramp_time 0.5
        in_waveform wave1 out_output
        response_time 5
    ctrl1

    chain
    lfo1
        modules
            synthmod name clock1
            synthmod name wave1
            synthmod name clock2
            synthmod name ctrl1
        modules
    lfo1

    copier [ from lfo1 to lfo2 ]
group1

copier [ from group1 to group2 ]

chain
ch1
    copy_only on

    // copy_only on - prevents the chain from pulling modules out of
    // their existing groups or chains, it prevents any name change
    // of existing modules whatsoever, and, just as it's name
    // suggests - it only copies the modules, it doesn't even
    // reproduce them in userspace, no ch1~* modules exist
    // (and actually nor can they exist because the 'ch1' name is now
    // taken).

    modules
        synthmod name group1.lfo1~clock1
        synthmod name group2.lfo2~wave1
        synthmod name group1.lfo2~clock2
        synthmod name group2.lfo1~ctrl1
    modules
ch1


copier [ from ch1 to eeeee ]


wcnt_exit [ in_bar t out_count exit_bar 1 ]

wcnt-1.32/jwmsynth







// the original chain data object stores a snapshot of the modules
// at the point of its creation, copying that chain yeilds those
// modules at any point

copier [ from ch1 to eeeee ]
