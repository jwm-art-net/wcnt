wcnt-1.32/jwmsynth

samplerate 44100

; simple.wc
;   creates a simple audio file consisting of a 220hrtz tone
;   for a duration of 1 second. it uses the fader to fade-in
;   and out at the start and end.
;

timer
t
    timings
        time seconds 0
        time seconds 1
    timings
    time_is_relative off
t

constant_freq
cf
    freq 220
cf

wave
s
    type            squ_01
    in_phase_step   off
s

wavfile_out
w
    filename        editor.wav
    data_format     float32
    in_signal       off
    in_bar          off
    start_bar       0
    end_bar         0
w

editor
[
    editlist
        edit w
            in_signal s out_output
            end_bar 1
            in_bar t out_count
        edit s
            type sine
            in_phase_step cf out_phase_step
    editlist
]

editor
[
    editlist
        edit w
            in_signal s out_output
            end_bar 1
            in_bar t out_count
        edit s
            type sine
            in_phase_step cf out_phase_step
    editlist
]


wcnt_exit
x
    in_bar      t out_count
    exit_bar    1
x

wcnt-1.32/jwmsynth
