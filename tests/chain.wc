wcnt-1.32/jwmsynth

samplerate 44100

; chain.wc
; chains two modules
; firstly by using the chain data object
; secondly by using the autochain_create directive
;
; note: this file is intended to be run with -v option so the messages
; display by it become headers amongst the verbose output.

clock x freq 1 x
constant one value 1.0 one

constant_freq f freq 777 f

wave w
    type sine
    in_phase_step f out_phase_step
w

mono_amp a
    in_signal w out_output
    gain 0.75
    in_amp_eg one out_output
a

;
; chain using data object...
;

chain c1
    modules
        synthmod name f
        synthmod name w
        synthmod name a
    modules
c1

;
; chain using directive...
;

autochain_create ac2
    constant_freq xf
        freq 555
    xf

    wave xw
        type sine
        in_phase_step xf out_phase_step
    xw

    mono_amp xa
        in_signal xw out_output
        gain 0.75
        in_amp_eg one out_output
    xa
ac2

;
; copy first chain
;
copier [ from c1 to c3 ]

;
; copy second chain
;
copier [ from ac2 to ac4 ]




wcnt_exit [ in_trig x out_phase_trig ]
;
;
;
wcnt-1.32/jwmsynth
