wcnt-1.32/jwmsynth
samplerate 44100

clock x freq 1 x

autogroup_create
g1
    constant_freq f freq 777 f
    wave w type sine in_phase_step f out_phase_step w
g1

// this chains pulls the modules out of g1 into the chain c1
chain
c1
    modules
        synthmod name g1.f
        synthmod name g1.w
    modules
c1

editor
[
    editlist
        edit c1~f freq 300
        edit c1~w type squ
    editlist
]

// make a copy the chain - edits don't affect copy held in the chain
copier [ from c1 to c2 ]

autogroup_add
g1
    // make another copy of the chain, but this time into group g1
    copier [ from c1 to c3 ]
g1

// copy the group
copier [ from g1 to g2 ]

// get out
wcnt_exit [ in_trig x out_phase_trig ]

wcnt-1.32/jwmsynth
