wcnt-1.32/jwmsynth

samplerate 44100


timer
t
    timings
        time seconds 0
        time seconds 132
    timings
    time_is_relative off
t

adsr
eg
    envelope
        section name attack
            time 0.5 level 1.0
        section name decay
            time 35.0 level 0.85
        section name release
            time 500 level 0
    envelope

    in_note_on_trig     t out_trig

    zero_retrigger   off
    min_time         10.0
    sustain_state    off
eg


clock
c
    freq .00803
c

wave w type sine in_phase_step c out_phase_step w

clock
c2
    freq .103
c2

wave w2 type sine in_phase_step c out_phase_step w2


constant_note n2f name e2 n2f


osc_clock
o1
        in_note_on_trig     t out_trig
        in_note_slide_trig  off
        in_frequency        n2f out_frequency
        octave_offset       0
        in_freq_mod1 w2 out_output
        freq_mod1_size 2
o1

osc_clock
o2
        in_note_on_trig     t out_trig
        in_note_slide_trig  off
        in_frequency        n2f out_frequency
        octave_offset       1
        in_freq_mod1    wp2 out_output
        freq_mod1_size  2
o2


wave
wpm
    in_phase_step o1 out_phase_step
    type sine
wpm


wave_phase
wp1
    in_phase_trig       o1  out_phase_trig
    in_phase_step       o1  out_phase_step
    type                sine
    on_trig_reset_phase on
    recycle_mode        off
    in_phase_mod     wpm out_output
    phase_mod_size 1.5
wp1


multiplier pm
in_signal1 wp1 out_output
in_signal2 w out_output
pm


wave_phase
wp2
    in_phase_trig       o1  out_phase_trig
    in_phase_step       o1  out_phase_step
    type                sine
    on_trig_reset_phase on
    recycle_mode off
    in_phase_mod    pm out_output //wp1 out_output
    phase_mod_size 1.5
wp2

wave_phase
wp3
    in_phase_trig       o2  out_phase_trig
    in_phase_step       o1  out_phase_step
    type                sine
    on_trig_reset_phase on
    recycle_mode on
    //in_phase_mod    wp1 out_output
    //phase_mod_size 0.25
    shape_type sine
    sync_shape on
    in_shape_phase_step o2 out_phase_step
wp3




wavfile_out
wav
    in_left   wp3 out_output
    in_right  wp3 out_output
    in_bar      t out_count
    snapshot_mode off
    data_format float32
    filename    wave_phase1.wav
    start_bar   0
    end_bar     1
wav


wcnt_exit
exit
    in_bar      t out_count
    exit_bar    1
exit


wcnt-1.32/jwmsynth





