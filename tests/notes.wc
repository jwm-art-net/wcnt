wcnt-1.32/jwmsynth

samplerate 44100



time_map
time
    meter_map
        meter tsig 4/4 bar 0
    meter_map
    bpm_map
        tempo bpm 130 bar 0
    bpm_map
    bpm_changes_relative off
time

riff
riff1
    quarter_value   64
    notelist
        note name c4    pos 0   len 50      vel 1.0
        note name c2    pos 0   len 50      vel 1.0
        note name f4    pos 64  len 20      vel 1.0
        note name f2    pos 64  len 20      vel 1.0
        note name e4    pos 96  len 8       vel 1.0
        note name c4    pos 128 len 30      vel 1.0
        note name e4    pos 160 len 26      vel 1.0
        note name g4    pos 208 len 12      vel 1.0
    notelist
riff1

riff
riff2
    quarter_value   64
    notelist
        note name c4    pos 0   len 255     vel 1.0
        note name d3    pos 16  len 224     vel 1.0
        note name e4    pos 32  len 192     vel 1.0
        note name f3    pos 48  len 160     vel 1.0
        note name g4    pos 64  len 128     vel 1.0
        note name a5    pos 80  len 96      vel 1.0
        note name b4    pos 96  len 64      vel 1.0
        note name c3    pos 112 len 32      vel 1.0
    notelist
riff2


sequencer
seq
    track
        riff_node
            riff riff2  bar 0   transpose 0
            repeat 7 repeat_stripe 1
    track
    start_bar 0
    connect time
seq

osc_clock
osc
    connect seq
    in_play_state       adsr out_play_state
    portamento_time     25
    response_time       1
osc

wave
wv
    in_phase_step   osc out_phase_step
    type saw
wv


adsr
adsr
    envelope
        section name attack  time 10 level 1.0
        section name decay   time 50 level 0.75
        section name release time 25 level 0.6
        section name release time 25 level 0.0
    envelope
    connect seq
    sustain_state    on
adsr

multiplier
out
    in_signal1 wv out_output
    in_signal2 adsr out_output
out

wavfile_out
wav
    in_left     out out_output
    in_right    out out_output
    in_bar      time out_bar
    data_format pcm16
    filename    notes.wav
    start_bar   0
    end_bar     6
wav

wcnt_exit
exit
    in_bar      time out_bar
    exit_bar    6
exit

wcnt-1.32/jwmsynth



