wcnt-1.32/jwmsynth

samplerate 44100


constant_freq
cf
    freq 111
cf

wave
w
    in_phase_step     cf out_phase_step
    type saw
w

clock
tik
    freq 3
tik

adsr
e
    envelope
        section name attack
            time 2 level 1
        section name decay
            time 20 level 0.6
        section name release
            time 195 level 0
    envelope
    in_note_on_trig tik out_phase_trig
    sustain_state off
    in_note_off_trig off
e

multiplier
m
    in_signal1 w out_output
    in_signal2 e out_output
m



group
g1
    modules
        synthmod name cf
        synthmod name w
        synthmod name tik
        synthmod name e
        synthmod name m
    modules
g1

copier [ from g1 to g2 ]

trig_counter
tc
    in_trig g1.tik out_phase_trig
tc

editor
[
    editlist
        edit g2.cf freq 333
        edit g2.tik freq 5
    editlist
]

wavfile_out
wav
    in_left     g1.m out_output
    in_right    g2.m out_output
    in_bar      tc    out_count
    data_format float32
    filename    group-data-object.wav
    start_bar   0
    end_bar     6
wav

wcnt_exit [ in_trig wav out_write_end_trig ]

wcnt-1.32/jwmsynth
