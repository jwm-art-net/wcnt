wcnt-1.32/jwmsynth

samplerate 44100


timer
t
    timings
        time seconds 0
        time seconds 1
    timings
    time_is_relative off
t


constant_note n2f name c-1 n2f


osc_clock
o1
        in_note_on_trig     t out_trig
        in_note_slide_trig  off
        in_frequency        n2f out_frequency
        octave_offset       0
o1


osc_clock
o2
        in_note_on_trig     t out_trig
        in_note_slide_trig  off
        in_frequency        n2f out_frequency
        octave_offset       1
o2


wave_phase
wp
    in_phase_trig       o1  out_phase_trig
    in_phase_step       o2  out_phase_step
    type                sine
    on_trig_reset_phase on
    recycle_mode        off
    invert_alt          off
    start_phase         0.25
    phase_cycles        1
    zero_when_off       on
wp


wavfile_out
wav
    in_signal   wp out_output
    in_bar      t out_count
    snapshot_mode off
    data_format pcm16
    filename    wave_phase.wav
    start_bar   0
    end_bar     1
wav


wcnt_exit
exit
    in_bar      t out_count
    exit_bar    1
exit


wcnt-1.32/jwmsynth



