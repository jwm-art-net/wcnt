wcnt-1.32/jwmsynth

samplerate 44100

timer
t
    timings
        time seconds 0
        time seconds 5
    timings
    time_is_relative off
t

autogroup_create
group1

    constant_freq
    cf1
        freq 111
    cf1

    wave
    w
        in_phase_step     cf1 out_phase_step
        type saw
    w

group1

autogroup_add
group1

    clock
    tik
        freq 3
    tik

    adsr
    e
        envelope
            section name attack
                time 2 level 1
            section name decay
                time 20 level 0.6
            section name release
                time 195 level 0
        envelope
        in_note_on_trig tik out_phase_trig
        sustain_state off
        in_note_off_trig off
    e

    multiplier
    m
        in_signal1 w out_output
        in_signal2 e out_output
    m

group1

copier [ from group1 to group2 ]

editor
[
    editlist
        edit group2.cf1 freq 333
        edit group2.tik freq 5
    editlist
]

wavfile_out
wav
    in_left   group1.m out_output
    in_right  group2.m out_output
    in_bar t    out_count
    data_format float32
    filename    group-names-test.wav
    start_bar   0
    end_bar     1
wav

wcnt_exit [ in_trig wav out_write_end_trig ]

wcnt-1.32/jwmsynth
