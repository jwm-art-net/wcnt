wcnt-1.30/jwmsynth

samplerate 44100

; autogroup.wc
;   testing autogroup feature

constant one value 1.0 one

// uncomment this copier and the group1 autogroup should fail
// copier group1 from one to two group1

// uncomment this autogroup_create directive and the timer module
// should fail due to being ungroupable
// autogroup_create group1

timer
t
    timings
        time seconds 0
        time seconds 1
    timings
    time_is_relative off
t

constant_freq
cf
    freq 1000
cf


autogroup_create
group1

    // uncommenting this 2nd autogroup should fail
    // autogroup_create group2

    // this constant freq should not result in name clash as it is
    // within the autogroup created group1

    constant_freq
    cf
        freq 110
    cf

    // within the autogroup created group1, connections are scoped to
    // modules within the group first, without having to specify the group
    // name (and not those with the same module name outside of the group).
    osc_clock
    osc
        in_note_on_trig t out_trig
        in_note_slide_trig off
        in_frequency cf out_frequency
    osc

    wave
    w
        in_phase_step     osc out_phase_step
        type saw
    w

    clock
    tik
        freq 1.0
    tik

group1

// do something else here...
// ... then resume adding modules to group1

autogroup_add
group1

    adsr
    e
        envelope
            section name attack
                time 2 level 1
            section name decay
                time 20 level 0.6
            section name release
                time 195 level 0
        envelope
        in_note_on_trig tik out_phase_trig
        sustain_state off
        in_note_off_trig off
    e

    multiplier
    m
        in_signal1 w out_output
        in_signal2 e out_output
    m

    // synth_file_reader not allowed inside autogroup
    // synth_file_reader sfr filename param_edit-basic.wc sfr

group1


wavfile_out
wav
    in_left     group1.m out_output
    in_bar t    out_count
    snapshot_mode off
    data_format float32
    filename    autogroup.wav
    start_bar   0
    end_bar     1
wav

wcnt_exit
x
    in_bar      t out_count
    exit_bar    1
x

wcnt-1.30/jwmsynth
