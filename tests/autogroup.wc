wcnt-1.32/jwmsynth

samplerate 44100

; autogroup.wc
;   testing autogroup feature

constant one value 1.0 one

// uncomment this copier and the group1 autogroup should fail
// copier group1 from one to two group1

// uncomment this autogroup_create directive and the timer module
// should fail due to being ungroupable
// autogroup_create group1

timer
t
    timings
        time seconds 0
        time seconds 1
    timings
    time_is_relative off
t

constant_freq
cf
    freq 777
cf

constant_freq
cf1
    freq 1000
cf1

constant_freq
cf2
    freq 2000
cf2


autogroup_create
group1

    // uncommenting this 2nd autogroup should fail
    // autogroup_create group2

    // within autogroups, connections are scoped to modules within the
    // group first, without having to specify the group name.
    // this scoping may cause modules within the group to hide modules
    // outside of it, rendering them inaccessible during the
    // autogrouping if there share the same name.

    // this constant freq should not result in name clash as it is
    // within the autogroup created group1

    constant_freq
    cf
        freq 111
    cf

    // due to scoping, this copier will copy the cf above not the
    // cf outside the autogroup:
    copier [ from cf to cf111 count 3 ]

    // duplicate module from outside of autogroup into autogroup
    copier [ from cf1 to cf2 ]

    // duplicate module from within of autogroup
    copier [ from cf2 to cf3 ]


    osc_clock
    osc
        in_note_on_trig t out_trig
        in_note_slide_trig off
        in_frequency cf out_frequency
    osc

    // outside of the autogroup however, the editor will allow us to
    // make the connection because there, modules are referenced by
    // their full grouped name.

    wave
    w
        in_phase_step     osc out_phase_step
        type saw
    w

    clock
    tik
        freq 1.0
    tik

group1

// do something else here...
// ... then resume adding modules to group1

autogroup_add
group1

    adsr
    e
        envelope
            section name attack
                time 2 level 1
            section name decay
                time 20 level 0.6
            section name release
                time 195 level 0
        envelope
        in_note_on_trig tik out_phase_trig
        sustain_state off
        in_note_off_trig off
    e

    multiplier
    m
        in_signal1 w out_output
        in_signal2 e out_output
    m

    // synth_file_reader not allowed inside autogroup
    // synth_file_reader [ filename param_edit-basic.wc ]

group1


autogroup_create
group2
    // can't use the copier to copy a group within an auto group
    // copier [ from group1 to groupee ]
group2

wavfile_out
wav
    in_signal   group1.m out_output
    in_bar t    out_count
    data_format float32
    filename    autogroup.wav
    start_bar   0
    end_bar     1
wav

wcnt_exit [ in_trig wav out_write_end_trig ]

wcnt-1.32/jwmsynth
