wcnt-1.32/jwmsynth

samplerate 44100

autogroup_create
g1
    clock c freq 300 c
    wave w type sine in_phase_step c out_phase_step w
    chain
    ccc
        modules
            synthmod name c
        modules
    ccc
g1

chain
ddd
    modules
        synthmod name g1.ccc~c
    modules
ddd

trig_counter
tc
    in_trig ddd~c out_phase_trig
    count 300
    pre_count 0
    wrap off
    in_reset_trig off
tc

wcnt_exit [ in_trig tc out_not_trig ]

wcnt-1.32/jwmsynth
