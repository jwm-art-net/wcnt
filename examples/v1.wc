wcnt-1.32/jwmsynth

samplerate 48000

time_map
time1
    meter_map
        meter tsig 4/4 bar 0
    meter_map

    bpm_changes_relative off

    bpm_map
        tempo bpm 90 bar 0
    bpm_map
time1


riff
riff1
    quarter_value   64
    notelist
        note name c4    pos 0   len 30  vel 1.0
        note name e4    pos 28  len 50  vel 1.0
        note name d3    pos 123 len 24  vel 1.0
        note name f4    pos 150 len 90  vel 1.0
        note zero_pos 256
        note name a4    pos 35  len 44 vel 1.0
        note name g5    pos 46  len 8 vel 1.0
        note name f4    pos 152  len 16 vel 1.0
        note zero_pos 256
        note name c4    pos 0   len 30  vel 1.0
        note name e4    pos 28  len 50  vel 1.0
        note name d3    pos 123 len 24  vel 1.0
        note name f4    pos 150 len 90  vel 1.0
        note zero_pos 256
        note name a4    pos 35  len 44 vel 1.0
        note name g5    pos 46  len 98 vel 1.0
        note name f4    pos 152  len 16 vel 1.0
    notelist
riff1


sequencer
seq1
    track
        riff_node
            riff riff1
            bar 0 repeat 4 repeat_stripe 4
            transpose 0
    track

    connect time1

    start_bar               0
seq1


synth_file_reader [ filename lfos.wch ]

editor
[
    editlist
        edit vlfo1.note_on
            in_trig seq1 out_note_on_trig
    editlist
]

copier [ from vlfo1 to vlfo2 count 3 ]

editor
[
    editlist
        edit vlfo1.c
            freq 13.65
            in_freq_mod1    vlfo3.w out_output
            freq_mod1_size  2.0
        edit vlfo2.c
            freq 6.25
        edit vlfo2.w
            ramp_time 50
        edit vlfo3.c
            freq 1.65
        edit vlfo4.c
            freq 0.1133
        edit glfo1.note_on in_trig seq1 out_start_trig
    editlist
]

adsr
adsr1
        envelope
        section name attack
            ut  15.0    ul  1.0
            lt  10.0    ll  0.25
        section name decay
            ut  35.0    ul  0.8
            lt  15.0    ll  0.1
        section name release
            ut  25.0    ul  0.3
            lt  15.0    ll  0.025
        section name release
            ut  175.0    ul  0.0
            lt  125.0    ll  0.0
        envelope

        connect seq1

        zero_retrigger   off
        min_time         10.0
        sustain_state    on
adsr1

adsr
adsr2
        envelope
        section name attack
            time 0.0 level 1.0
        section name decay
            time 33.0 level 0.0
        section name release
            time 0 level 0
        envelope

        connect seq1

        zero_retrigger   off
        min_time         10.0
        sustain_state    on
adsr2

autogroup_create
v1
    osc_clock
    osc1
        connect seq1
        in_play_state   adsr1   out_play_state
        in_freq_mod1    vlfo1.w out_output
        freq_mod1_size 1.05
        in_freq_mod2    vlfo3.w out_output
        freq_mod2_size 1.15
    osc1

    wave_phase
    w
        type squ
        in_phase_trig osc1 out_phase_trig
        on_trig_reset_phase off
        recycle_mode on
        in_phase_step   osc1 out_phase_step
        in_phase_mod vlfo2.w out_output
        phase_mod_size 1.5
    w
v1

copier [ from v1 to v2 count 3 ]

editor
[
    editlist
        edit v2.osc1
            octave_offset 1
            tuning_semitones 5
            in_freq_mod2 adsr2 out_output
            freq_mod2_size 2.0
        edit v1.w
            shape_type squ
            in_phase_mod vlfo4.w out_output
            in_shape_phase_step v2.osc1 out_phase_step

    editlist
]

osc_clock
fosc
    connect seq1
    octave_offset 1
    tuning_semitones 3
    in_freq_mod1    glfo1.w out_output
    freq_mod1_size 2.0
    in_freq_mod2    vlfo3._w out_output
    freq_mod2_size 2.0
fosc

glame_butterworth
f1
    filter_type lowpass
    in_signal v1.w out_output
    in_cutoff_phase_step fosc out_phase_step
    resonance 0.5
f1

mono_amp
amp1
    in_signal   f1 out_output
    gain        1.0
    in_amp_eg   adsr1 out_output
    in_amp_mod  off
    amp_mod_size   0.0
    clip_level    1.0
amp1

echo
el
    in_signal amp1 out_output
    gain 0.85
    delay_time 123
    in_feedback er out_wet_output
    feedback 0.653
    in_feedback_mod ec out_output
    feedback_mod_size 0.5
    wet/dry 0.3
el

echo
er
    in_signal amp1 out_output
    gain 0.85
    delay_time 443
    in_feedback el out_wet_output
    feedback 0.653
    in_feedback_mod ec out_output
    feedback_mod_size 0.5
    wet/dry 0.3
er

echo
ec
    in_signal er out_wet_output
    gain 1.0
    delay_time 515
    in_feedback el out_wet_output
    feedback 0.8
    wet/dry 0.3
ec


wavfile_out
wav1
    filename    v1.wav
    data_format float32
    in_left el out_output
    in_right er out_output
    in_bar      time1   out_bar
    start_bar   0
    end_bar     17
wav1

// setup how long to process:

wcnt_exit
[
    in_trig     wav1    out_write_end_trig
]


//------------------------------------------------------------------------
// End Of File _jwm 2005.
//------------------------------------------------------------------------
wcnt-1.32/jwmsynth
