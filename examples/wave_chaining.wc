wcnt-1.32/jwmsynth

samplerate 44100


timer
t
    timings
        time seconds 0
        time seconds 30
    timings
    time_is_relative off
t


constant_note n2f name c2 n2f

autochain_create
osc1

    clock
    lfoc
        freq 0.125
    lfoc
    wave lfow type sine in_phase_step lfoc out_phase_step lfow

    osc_clock
    c1
            in_note_on_trig     t out_trig
            in_note_slide_trig  off
            in_frequency        n2f out_frequency
            octave_offset -1
    c1

    square_wave
    sq1
        connect c1
        pulse_width    0.5
        in_pwm         lfow out_output
        pwm_size       0.9
        recycle_mode   off
    sq1

    osc_clock
    c2
            in_note_on_trig     t out_trig
            in_note_slide_trig  off
            in_frequency        n2f out_frequency
            octave_offset       0
            tuning_semitones 0
    c2

    osc_clock
    c3
            in_note_on_trig     t out_trig
            in_note_slide_trig  off
            in_frequency        n2f out_frequency
            octave_offset       1
            tuning_semitones 0
    c3

    logic_trigger
    lt
        in_trig1 c1 out_phase_trig
        in_trig2 sq1 out_pulse_off_trig
        function or
    lt

    pattern_trig
    pt
        in_trig c1 out_phase_trig
        pattern 10
    pt

    wave_phase
    wp1
        in_phase_trig       c1  out_phase_trig // pt out_not_trig
        in_phase_step       c2  out_phase_step
        type                sine
        on_trig_reset_phase on
        recycle_mode        on
        invert_alt          off
        start_phase         0
        phase_cycles        1
        zero_when_off       on
        in_phase_mod    wp2 out_output
        phase_mod_size 0.5
    wp1

    wave_phase
    wp2
        in_phase_trig       sq1 out_pulse_off_trig //pt  out_trig
        in_phase_step       c3  out_phase_step
        type                sine
        on_trig_reset_phase on
        recycle_mode        on
        invert_alt          off
        start_phase         0
        phase_cycles        1
        zero_when_off       on
        in_phase_mod    wp1 out_output
        phase_mod_size 0.1
    wp2

    switcher
    wv
        in_trig lt out_trig
        signals
            synthmod name wp1
            synthmod name wp2
        signals
    wv

    glame_filter
    lpf
        filter_type lowpass
        freq 8000
        in_signal wv out_output
        stages 1
    lpf

osc1


wavfile_out
wav
    in_signal   osc1~lpf out_output
    in_bar      t out_count
    snapshot_mode off
    data_format float32
    filename    wave_chaining.wav
    start_bar   0
    end_bar     1
wav


wcnt_exit
exit
    in_bar      t out_count
    exit_bar    1
exit


wcnt-1.32/jwmsynth



