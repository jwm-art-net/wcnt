wcnt-1.32/jwmsynth
//------------------------------------------------------------------------
//
//  produces a bass line
//
//------------------------------------------------------------------------

header header.wch

//------------------------------------------------------------------------

synth_file_reader
timefile
    filename time.wch
timefile

riff
riff1
    quarter_value   64
    notelist
        note name c0   pos 0    len 60  vel 1.0
        note name c1   pos 32   len 16  vel 1.0
        note name f0   pos 64   len 60  vel 1.0
        note name c1   pos 96   len 12  vel 1.0
        note name e0   pos 112  len 8   vel 1.0
        note name c0   pos 128  len 60  vel 1.0
        note name c1   pos 160  len 52  vel 1.0
        note name e0   pos 172  len 16  vel 1.0
        note name c-1  pos 192  len 16  vel 1.0
        note name e1   pos 208  len 12  vel 1.0
        note name g1   pos 224  len 16  vel 1.0
    notelist
riff1

riff
riff_sc
    quarter_value   64
    notelist
        note name c0   pos 0     len 8  vel 0.75
        note name d0   pos 32    len 8  vel 0.4
        note name e0   pos 64    len 8  vel 0.5
        note name f0   pos 96    len 8  vel 0.6
        note name g0   pos 128   len 8  vel 0.7
        note name a0   pos 160   len 8  vel 0.8
        note name b0   pos 192   len 8  vel 0.9
        note name c1   pos 224   len 8  vel 1.0
    notelist
riff_sc

copier [ from riff1 to riff1a ]
copier [ from riff1 to riff1b ]

riff_editor
[
    riff riff1a
    notelist
        note name <P+N pos 128.0 len 8.0 vel 0.0
        note name OP*L pos 96 len 64 vel 0.125
    notelist
]

riff_editor
[
    riff riff1b
    notelist
        note name >P-N pos 128.0 len 8.0 vel 0.0
        note name IP*L pos 96 len 64 vel 1.125
    notelist
]

clock
clock1
    freq            0.025
clock1

copier [ from clock1 to clock2 count 2 ]

wave
sinetime
    type sine
    in_phase_step   clock1 out_phase_step
sinetime

copier c9 from sinetime to sine3 c9

sequencer
seq1
    track
        riff_node
            riff riff1a
            bar 0 repeat 3 repeat_stripe 4
            transpose 0
        riff_node
            riff riff1a
            bar 2 repeat 3 repeat_stripe 4
            transpose 5
        riff_node
            riff riff1b
            bar 1 repeat 3 repeat_stripe 4
            transpose 4
        riff_node
            riff riff1b  bar 3
            repeat 3 repeat_stripe 4
            transpose 7
    track

    connect time1

    start_bar               0
    velocity_response_time  5
seq1

adsr
adsr1
        envelope
        section name attack
            ut  15.0    ul  1.0
            lt  10.0    ll  0.25
        section name decay
            ut  35.0    ul  0.8
            lt  15.0    ll  0.1
        section name release
            ut  25.0    ul  0.3
            lt  15.0    ll  0.025
        section name release
            ut  175.0    ul  0.0
            lt  125.0    ll  0.0
        envelope

        connect seq1

        zero_retrigger   off
        min_time         10.0
        sustain_state    on
adsr1


copier [ from adsr1 to adsr2 ]

osc_clock
osc1
        in_note_on_trig     seq1    out_note_on_trig
        in_note_slide_trig  seq1    out_note_slide_trig
        in_play_state       adsr2   out_play_state
        in_frequency        seq1    out_frequency
        octave_offset       -2
        portamento_time     15.0
        response_time       5.0
osc1

copier [ from osc1 to osc2 ]

wave
sine
    type sine
    in_phase_step   osc1 out_phase_step
sine

copier [ from sine to sine2 ]

multiplier
m1
    in_signal1 sine2       out_output
    in_signal2 sinetime    out_output
m1

contraster
con1
    in_signal            sine   out_output
    in_power_mod         m1     out_output
    power_min  1.0
    power_max  3.0
    rude_mode  off
    in_rude_switch_trig  seq1   out_note_on_trig
    wet/dry    0.125
con1

copier [ from con1 to con2 ]

sample_hold
sh1
    in_trig     seq1    out_note_on_trig
    in_signal   sine3   out_output
    decay_time  25
sh1

editor
[
    editlist
        edit con2
            in_signal   adsr1   out_output
            power_max   6.0

        edit adsr2
            in_note_on_trig     clock2  out_phase_trig
            in_note_off_trig    off
            sustain_state       off

        edit sine2
            in_phase_step       osc2    out_phase_step

        edit sine3
            in_phase_step       clock3  out_phase_step

        edit osc2
            in_freq_mod1        sh1     out_output
            octave_offset   -1
            freq_mod1_size  2.0

        edit clock2
            freq            1.75

        edit clock3
            freq            8.076

    editlist
]

dynamic
dynsine
    amp_map
        dvertex
            sigin_level 0.0
                so_ul 3.0
                so_ll 1.0
        dvertex
             sigin_level 0.25
                so_ul 2
                so_ll 1.0
        dvertex
             sigin_level 0.5
                so_ul 1.5
                so_ll 1.0
        dvertex
             sigin_level 0.75
                so_ul 1.25
                so_ll 1.0
        dvertex
             sigin_level 1.0
                so_ul 1.0
                so_ll 1.0
    amp_map
    in_signal       con1 out_output
    in_modulation   adsr2 out_output
    up_thresh       1.0
    lo_thresh       0.3
    posneg_mirror   on
    use_ratios      on
dynsine

peak_detector
peaker
    in_signal     dynsine out_output
    sig_range_hi  1.0
    sig_range_lo  -1.0
    message       dynsine_peaked@:
    force_abort   off
    max_peaks     5
peaker

mono_amp
amp1
    in_signal   dynsine out_output
    gain        1.0
    in_amp_eg   con2    out_output
    in_amp_mod  seq1    out_velocity_ramp
    amp_mod_size   0.0
    clip_level    1.0
amp1

wavfile_out
wav1
    filename    bass01.wav
    data_format float32
    in_signal   amp1 out_output
    in_bar      time1   out_bar
    start_bar   0
    end_bar     16
wav1

// setup how long to process:

wcnt_exit
[
    in_trig     wav1    out_write_end_trig
]

//------------------------------------------------------------------------
// End Of File _jwm 2005.
//------------------------------------------------------------------------
wcnt-1.32/jwmsynth
