wcnt-1.32/jwmsynth


header header.wch


time_map
tm
    meter_map
        meter tsig 4/4 bar 0
    meter_map
    bpm_map
        tempo bpm 130 bar 0
    bpm_map
tm


riff
riff1
    quarter_value   32
    notelist
        note name c0   pos 0    len 10  vel 1.0
        note name c2   pos 16   len 26  vel 1.0
        note name f0   pos 48   len 20  vel 1.0
        note name c2   pos 96   len 12  vel 1.0
        note name e0   pos 112  len 8   vel 1.0
        note name c0   pos 128  len 20  vel 1.0
        note name e2   pos 140  len 8  vel 1.0
        note name c1   pos 160  len 52  vel 1.0
        note name e0   pos 196  len 56  vel 1.0
    notelist
riff1


sequencer
seq1
    track
        riff_node
            riff riff1
            bar 0 repeat 30 repeat_stripe 1
            transpose 0
    track

    start_bar               0
    in_bar              tm out_bar
    in_bar_trig         tm out_bar_trig
    in_beats_per_bar    tm out_beats_per_bar
    in_beat_value       tm out_beat_value
    in_pos_step_size    tm out_pos_step_size
    velocity_response_time  5
seq1


synth_file_reader
sfr
    filename voice-part.wch
sfr


autogroup_add
voice-part

    // data objects (ie not modules) such as the input editor are not
    // actually grouped, however, when they are situated inside an
    // autogroup section, they use the group "namespace".  this means
    // the output modules specified for inputs are firstly assumed to
    // be modules in the group. if no such module exists with the group
    // only then is the module for the connection looked for outside of
    // the group.

    input_editor
    ie
        editlist
            connect enter in_note_on_trig    seq1 out_note_on_trig
            connect enter in_note_slide_trig seq1 out_note_slide_trig
            connect enter in_note_off_trig   seq1 out_note_off_trig
            connect enter in_frequency       seq1 out_frequency
            connect enter in_velocity        seq1 out_velocity
        editlist
    ie

voice-part


osc_clock
eqclk
        in_note_on_trig     seq1 out_note_on_trig
        in_note_slide_trig  seq1 out_note_slide_trig
        in_frequency        seq1 out_frequency
        tuning_semitones -6
        octave_offset  -1
eqclk


single_band_parametric
eq
    in_signal           voice-part.out out_output
    in_phase_step       eqclk out_phase_step
    gain_db             8
    bandwidth           .25
eq


echo
el
    in_signal eq out_output
    gain               0.5
    delay_time         71
    feedback           .375
    wet/dry            0.23
el


echo
er
    in_signal eq out_output
    gain               0.5
    delay_time         76
    feedback           .375
    wet/dry            0.23
er


stereo_amp
stout
    in_left       el out_output
    in_right      er out_output
    left_level    0.7
    right_level   0.7
    clip_level    0.99
stout


wavfile_out
wfo
    filename    voice-part-sequenced.wav
    data_format pcm16
    in_left     stout out_left
    in_right    stout out_right
    in_bar      tm out_bar
    start_bar   0
    end_bar     129
    snapshot_mode off
wfo


wcnt_exit
exit
    in_bar      tm out_bar
    exit_bar    32
exit


wcnt-1.32/jwmsynth
