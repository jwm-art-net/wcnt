wcnt-1.32/jwmsynth
header header.wch

autogroup_create
voice-snare

    wcnt_note
    enter
        // this must be connected up by whichever file
        // includes this one.
        connect off
    enter

    adsr
    env1
        // intended volume envelope
        envelope
            section name attack
                ut  0.50    ul  1.0
                lt  0.50    ll  1.0
            section name decay
                ut  25.0   ul  0.6
                lt  20.0   ll  0.6
            section name decay
                ut  55.0   ul  0.23558
                lt  40.0   ll  0.23558
            section name release
                ut  105.0   ul  0.0
                lt  95.0   ll  0.0
        envelope

        connect enter

        max_sustain_time 25.0
        sustain_state    off
    env1

    adsr
    env2
        // intended PM envelope
        envelope
            section name attack
                ut  16.0    ul  0.25
                lt  16.0    ll  0.25
            section name attack
                ut  160.0    ul  1.0
                lt  160.0    ll  1.0
            section name decay
                ut  75.0   ul  0.192
                lt  55.0   ll  0.192
            section name release
                ut  155.0   ul  0.0
                lt  135.0   ll  0.0
        envelope

        connect enter

        up_thresh        1.0
        lo_thresh        0.0
        start_level      0.0
        min_time         3.0
        max_sustain_time 2.0
        sustain_state    off
    env2


    osc_clock
    o1
        connect enter
        octave_offset   -1
    o1

    mono_amp
    pm2
        in_signal wp2 out_output
        in_amp_eg env2 out_output
        eg_amount 0.98750
    pm2

    wave_phase
    wp1
        type sine
        in_phase_trig        o1 out_phase_trig
        in_phase_step        o1 out_phase_step
        on_trig_reset_phase  off
        phase_cycles         1.0
        start_phase          0.0
        in_phase_mod         pm2 out_output
        phase_mod_size       3.0
        invert_alt           off
        zero_when_off        off
        recycle_mode         off
    wp1


    osc_clock
    o2
        connect enter
        tuning_semitones    1.0
        octave_offset   -1
        in_freq_mod1    env2 out_output
        freq_mod1_size 2
    o2

    mono_amp
    pm3
        in_signal wp3 out_output
        in_amp_eg env2 out_output
        eg_amount 0.9875
    pm3

    wave_phase
    wp2
        type sine
        in_phase_trig        o2 out_phase_trig
        in_phase_step        o2 out_phase_step
        on_trig_reset_phase  off
        phase_cycles         1.0
        start_phase          0.0
        in_phase_mod         pm3 out_output
        phase_mod_size     2.0
        invert_alt           off
        zero_when_off        off
        recycle_mode         off
    wp2


    osc_clock
    o3
        connect enter
        tuning_semitones    4.0
        octave_offset   1
    o3

    mono_amp
    pm1
        in_signal wp1 out_output
        in_amp_eg env2 out_output
        eg_amount 0.9850
    pm1

    wave_phase
    wp3
        type sine
        in_phase_trig        o3 out_phase_trig
        in_phase_step        o3 out_phase_step
        on_trig_reset_phase  off
        phase_cycles         1.0
        start_phase          0.0
        in_phase_mod         pm1 out_output
        phase_mod_size     1.0
        invert_alt           off
        zero_when_off        off
        recycle_mode         off
    wp3

    osc_clock
    o4
        connect enter
        tuning_semitones    6.0
        octave_offset   2
        in_freq_mod1 env1 out_output
        freq_mod1_size 1.03
    o4

    glame_butterworth
    lpf
        filter_type           lowpass
        in_signal             wp1 out_output
        in_cutoff_phase_step  o4 out_phase_step
        resonance             0.84163
    lpf


    stereo_amp
    out
        in_signal lpf out_output
        gain 0.75
        in_amp_eg env1 out_output
        clip_level 1.0
    out


voice-snare

wcnt-1.32/jwmsynth
