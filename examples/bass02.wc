wcnt-1.32/jwmsynth
//------------------------------------------------------------------------
//
//  produces a bass line
//
//------------------------------------------------------------------------

header header.wch

//------------------------------------------------------------------------

synth_file_reader
bass01_wc
    filename bass01.wc
bass01_wc

group
g1
    modules
        synthmod name clock1
        synthmod name clock2
        synthmod name clock3
        synthmod name sinetime
        synthmod name adsr1
        synthmod name adsr2
        synthmod name osc1
        synthmod name osc2
        synthmod name sine
        synthmod name m1
        synthmod name con1
        synthmod name con2
        synthmod name sh1
        synthmod name dynsine
        synthmod name amp1
    modules
g1

copier [ from g1 to g2 count 2 ]

editor
[
    editlist
        edit g2.clock2
            freq            0.975
        edit g2.clock3
            freq            2.076
        edit g2.con2
            power_max       12.0
        edit g2.osc1
            tuning_semitones    -3

        edit g3.clock2
            freq            3.975
        edit g3.clock3
            freq            9.076
        edit g3.con2
            power_max       24.0
        edit g3.osc1
            tuning_semitones  1
        edit wav1
            filename    bass02.wav
            in_left     mix1    out_left
            in_right    mix1    out_right
    editlist
]



mix_chan ch1 in_signal   g1.amp1 out_output     ch1
mix_chan ch2 in_signal   g2.amp1 out_output     ch2
mix_chan ch3 in_signal   g3.amp1 out_output     ch3


mixer
mix1
    mix
        synthmod name ch1
        synthmod name ch2
        synthmod name ch3
    mix
    gain  0.37
mix1

//------------------------------------------------------------------------
// End Of File _jwm 2005.
//------------------------------------------------------------------------
wcnt-1.32/jwmsynth
