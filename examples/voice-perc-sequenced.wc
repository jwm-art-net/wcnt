wcnt-1.32/jwmsynth


synth_file_reader [ filename samplerate.wch ]


time_map
tm
    meter_map
        meter tsig 4/4 bar 0
    meter_map
    bpm_changes_relative off
    bpm_map
        tempo bpm 130 bar 0
    bpm_map
tm

constant one value 1.0 one

sync_clock
16ths
    quarter_value 64
    len 32
    snap_to 8
    connect tm
    in_freq_mod1    lfowv out_output
    freq_mod1_size  3
16ths


sync_clock
lfosyc
    quarter_value 64
    len 512
    snap_to 64
    connect tm
lfosyc

wave
lfowv
    in_phase_step lfosyc out_phase_step
    type sine
lfowv


pattern_trig    cow-pat   in_trig 16ths out_phase_trig
    pattern 0100001000010000-0001000010000100
cow-pat

pattern_trig    snare-pat   in_trig 16ths out_phase_trig
    pattern 0010001000100100-0010001000100001
snare-pat

pattern_trig    kick-pat    in_trig 16ths out_phase_trig
    pattern 1000100010010010-1000100010001010
kick-pat



constant   cow-note1    value 400     cow-note1
constant   cow-note2    value 500     cow-note2
constant   cow-note3    value 600     cow-note3

constant_note   snare-note  name c1     snare-note
constant_note   kick-note   name e-2    kick-note


synth_file_reader
sfr1
    filename voice-kick.wch
sfr1

autogroup_add
voice-kick

    // data objects (ie not modules) such as the input editor are not
    // actually grouped, however, when they are situated inside an
    // autogroup section, they use the group "namespace".  this means
    // the output modules specified for inputs are firstly assumed to
    // be modules in the group. if no such module exists with the group
    // only then is the module for the connection looked for outside of
    // the group.

    editor
    [
        editlist
            edit enter
                in_note_on_trig       kick-pat out_trig
                in_frequency          kick-note out_frequency
                in_velocity           one out_output
            edit o1
                in_freq_mod1    lfowv out_output
                freq_mod1_size  2.0
        editlist
    ]

voice-kick


synth_file_reader
sfr2
    filename voice-snare.wch
sfr2

autogroup_add
voice-snare

    editor
    [
        editlist
            edit enter
                in_note_on_trig       snare-pat out_trig
                in_frequency          snare-note out_frequency
                in_velocity           one out_output
        editlist
    ]

voice-snare

synth_file_reader
[
    filename voice-cow.wch
]

autogroup_add
voice-cow

    switcher
    cowfreq
        in_trig cow-pat out_trig
        signals
            synthmod name cow-note1
            synthmod name cow-note2
            synthmod name cow-note3
        signals
    cowfreq

    editor
    [
        editlist
            edit enter in_note_on_trig       cow-pat out_trig
            edit enter in_frequency          cowfreq out_output
            edit enter in_velocity           one out_output
        editlist
    ]

voice-cow


mixer
mix
    mix
        synthmod name voice-kick.out
        synthmod name voice-snare.out
        synthmod name voice-cow.out
    mix
    gain 0.5
mix

echo
el
    in_signal mix out_left
    delay_time 137
    feedback 0.87
    in_feedback     hpf out_output
    wet/dry 0.3
el

constant_freq lpff freq 660 lpff
constant_freq hpff freq 13000 hpff


glame_butterworth
lpf
    filter_type           lowpass
    in_signal             el out_wet_output
    in_cutoff_phase_step  lpff out_phase_step
    resonance             0.52
lpf

echo
er
    in_signal mix out_left
    delay_time 783
    feedback 0.87
    in_feedback     lpf out_output
    wet/dry 0.3
er

glame_butterworth
hpf
    filter_type           highpass
    in_signal             er out_wet_output
    in_cutoff_phase_step  hpff out_phase_step
    resonance             0.52
hpf


wavfile_out
wfo
    filename    voice-perc-sequenced.wav
    data_format pcm16
    in_left     el out_output //mix out_left
    in_right    er out_output //mix out_right
    in_bar      tm out_bar
    start_bar   0
    end_bar     34
    snapshot_mode off
wfo


wcnt_exit
exit
    in_bar      tm out_bar
    exit_bar    34
exit


wcnt-1.32/jwmsynth
