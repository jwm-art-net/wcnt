wcnt-1.32/jwmsynth
//------------------------------------------------------------------------
//
//  prettymuch unsequenced ---- but it could be sequenced if you add more
//  notes to the riff.
//
//------------------------------------------------------------------------


// note: this file is samplerate dependent due to the high octave_offset
// on the oscillator clock driving the fractal orbit module.
// the difference in output due to changed sample rate cause me to think
// i had introduced an error during my conversion of this file from
// using the input_editor and param_editor to their 'editor',
// replacement.

// the sound i recognize for this file is reproduced by using a
// samplerate of 44100 (currently wcnt's newly introduced default
// samplerate unless user specifies otherwise).

samplerate 44100

synth_file_reader [ filename time.wch ]

//------------------------------------------------------------------------


riff
riffl
    quarter_value   1
    notelist
        note name c0 pos 0  len 57  vel 1.0
    notelist
riffl

sequencer
seq1
    track
        riff_node
            riff riffl  bar 0   transpose 0
            repeat 0 repeat_stripe 1
    track
    in_bar              time1 out_bar
    in_bar_trig         time1 out_bar_trig
    in_pos_step_size    time1 out_pos_step_size
    in_beats_per_bar    time1 out_beats_per_bar
    in_beat_value       time1 out_beat_value
    start_bar 0
    velocity_response_time 5
seq1

autogroup_create
g01
    adsr
    adsr1
            envelope
                section name attack
                    time 1000.0 level 1.0
                section name decay
                    time 2005.0 level 0.99
                section name release
                    time 1005.0 level 0.3
                section name release
                    time 2005.0 level 0.0
            envelope

            connect seq1
            min_time         5.0
            max_sustain_time 0.0 // 0 = sustain forever until note off
            release_is_ratio off
            sustain_state    on
            zero_retrigger   off
    adsr1

    osc_clock
    orb_clock
            connect seq1
            in_play_state       adsr1   out_play_state
            in_freq_mod1        orbit1 out_x
            in_freq_mod2        orbit1 out_y
            octave_offset       8
            tuning_semitones    3
            portamento_time     15.0
            response_time       5.0
            freq_mod1_size      4
            freq_mod2_size      4
    orb_clock

    orbit
    orbit1
        in_restart_trig  off
        in_trig          orb_clock  out_phase_trig
        orbit_type       hopalong
        a  4.2
        b -3.1
        c  2.7
        test_iterations  100000
    orbit1

    osc_clock
    osc-l
            connect seq1
            in_play_state       adsr1   out_play_state
            in_freq_mod1        orbit1 out_x
            in_freq_mod2        orbit1 out_y
            octave_offset       -2
            tuning_semitones    0
            portamento_time     15.0
            response_time       5.0
            freq_mod1_size      2.0
            freq_mod2_size      4.0
    osc-l

    wave
    sine-l
        in_phase_step  osc-l out_phase_step
        type sine
    sine-l

    copier [ from osc-l to osc-r ]
    copier [ from sine-l to sine-r ]

    editor
    [
        editlist
            edit sine-r
                in_phase_step   osc-r out_phase_step
            edit osc-r
                freq_mod1_size 4.0
                freq_mod2_size 2.0
        editlist
    ]

    multiplier shaped-l
        in_signal1 sine-l  out_output
        in_signal2 adsr1   out_output
    shaped-l

    multiplier shaped-r
        in_signal1 sine-r  out_output
        in_signal2 adsr1   out_output
    shaped-r
g01

copier [ from g01 to g02 count 7 ]


editor
[
    editlist
        edit g01.orbit1
            orbit_type             hopalong
            a .0001
            b .0001
            c .0001
        edit g02.orbit1
            orbit_type             quadrup
            a -.0002
            b .0002
            c .0002
        edit g03.orbit1
            orbit_type             hopalong
            a .0003
            b -.0003
            c .0003
        edit g04.orbit1
            orbit_type             quadrup
            a .0004
            b .0004
            c -.0004
        edit g05.orbit1
            orbit_type             hopalong
            a .0005
            b .0005
            c .0005
        edit g06.orbit1
            orbit_type             quadrup
            a -.0006
            b .0006
            c .0006
        edit g07.orbit1
            orbit_type             hopalong
            a .0007
            b -.0007
            c .0007
        edit g08.orbit1
            orbit_type             quadrup
            a .0008
            b .0008
            c -.0008

        edit g02.osc-l
            freq_mod1_size 4.0
            freq_mod2_size 2.0
        edit g02.osc-r
            freq_mod1_size 2.0
            freq_mod2_size 4.0
        edit g04.osc-l
            freq_mod1_size 4.0
            freq_mod2_size 2.0
        edit g04.osc-r
            freq_mod1_size 2.0
            freq_mod2_size 4.0
        edit g05.osc-l
            octave_offset -1
            tuning_semitones 1
            freq_mod1_size 4.0
            freq_mod2_size 2.0
        edit g05.osc-r
            octave_offset -1
            tuning_semitones 1
            freq_mod1_size 2.0
            freq_mod2_size 4.0
        edit g06.osc-l
            octave_offset -1
            tuning_semitones -2
            freq_mod1_size 4.0
            freq_mod2_size 2.0
        edit g06.osc-r
            octave_offset -1
            tuning_semitones -2
            freq_mod1_size 2.0
            freq_mod2_size 4.0
        edit g07.osc-l
            tuning_semitones 5
            octave_offset -1
        edit g07.osc-r
            tuning_semitones 5
            octave_offset -1
        edit g08.osc-l
            tuning_semitones -7
            octave_offset 0
        edit g08.osc-r
            tuning_semitones -7
            octave_offset 0
    editlist
]

copier [ from g01 to g09 ]
copier [ from g02 to g10 ]
copier [ from g03 to g11 ]
copier [ from g04 to g12 ]
copier [ from g05 to g13 ]
copier [ from g06 to g14 ]
copier [ from g07 to g15 ]
copier [ from g08 to g16 ]


editor
[
    editlist
        edit g09.orbit1 orbit_type quadrup
        edit g10.orbit1 orbit_type hopalong
        edit g11.orbit1 orbit_type quadrup
        edit g12.orbit1 orbit_type hopalong
        edit g13.orbit1 orbit_type quadrup
        edit g14.orbit1 orbit_type hopalong
        edit g15.orbit1 orbit_type quadrup
        edit g16.orbit1 orbit_type hopalong
    editlist
]


combiner
cmb-l
    signals
        synthmod name g01.shaped-l
        synthmod name g02.shaped-l
        synthmod name g03.shaped-l
        synthmod name g04.shaped-l
        synthmod name g05.shaped-l
        synthmod name g06.shaped-l
        synthmod name g07.shaped-l
        synthmod name g08.shaped-l
        synthmod name g09.shaped-l
        synthmod name g10.shaped-l
        synthmod name g11.shaped-l
        synthmod name g12.shaped-l
        synthmod name g13.shaped-l
        synthmod name g14.shaped-l
        synthmod name g15.shaped-l
        synthmod name g16.shaped-l
    signals
    mean_total on
cmb-l

combiner
cmb-r
    signals
        synthmod name g01.shaped-r
        synthmod name g02.shaped-r
        synthmod name g03.shaped-r
        synthmod name g04.shaped-r
        synthmod name g05.shaped-r
        synthmod name g06.shaped-r
        synthmod name g07.shaped-r
        synthmod name g08.shaped-r
        synthmod name g09.shaped-r
        synthmod name g10.shaped-r
        synthmod name g11.shaped-r
        synthmod name g12.shaped-r
        synthmod name g13.shaped-r
        synthmod name g14.shaped-r
        synthmod name g15.shaped-r
        synthmod name g16.shaped-r
    signals
    mean_total on
cmb-r

stereo_amp amp1
    in_left    cmb-l out_output
    in_right   cmb-r out_output
    in_amp_eg  one   out_output
    in_amp_mod off
    gain   1.0
    amp_mod_size 0.0
    clip_level   1.0
amp1

wavfile_out
wav1
    in_left     amp1    out_left
    in_right    amp1    out_right
    in_bar      time1   out_bar
    snapshot_mode off
    data_format float32
    filename    sequenced_orbit.wav
    start_bar   0
    end_bar     16
wav1

// setup how long to process:

wcnt_exit
wcnt_exit_module
    in_bar  time1   out_bar
    exit_bar    16
wcnt_exit_module


wcnt-1.32/jwmsynth
